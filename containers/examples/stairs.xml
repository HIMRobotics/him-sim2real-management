<mujoco model="g1_parkour_course_v4">
  <include file="g1_robot.xml"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.65 0.65 0.65" ambient="0.2 0.2 0.22" specular="0.5 0.5 0.5"/>
    <rgba haze="0.12 0.18 0.28 1"/>
    <global azimuth="125" elevation="-12"/>
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.16 0.24 0.38" rgb2="0.02 0.03 0.06" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.24 0.3" rgb2="0.12 0.14 0.18"
      markrgb="0.4 0.45 0.5" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.12"/>
    <material name="start_mat" rgba="0.22 0.55 0.35 1"/>
    <material name="stair_mat" rgba="0.85 0.45 0.18 1"/>
    <material name="stair2_mat" rgba="0.78 0.40 0.22 1"/>
    <material name="stair3_mat" rgba="0.72 0.36 0.28 1"/>
    <material name="top_mat" rgba="0.28 0.52 0.85 1"/>
    <material name="finish_mat" rgba="0.92 0.78 0.18 1"/>
    <material name="zone_mat" rgba="0.25 0.95 0.45 0.35"/>
  </asset>

  <worldbody>
    <light name="key" pos="1.3 1.0 3.0" dir="-0.3 -0.25 -1" diffuse="0.95 0.95 0.9"/>
    <light name="rim" pos="-0.5 -1.0 2.2" dir="0.35 0.5 -1" diffuse="0.32 0.36 0.48"/>
    <geom name="safety_floor" type="plane" size="0 0 0.05" material="groundplane" friction="1.15"/>

    <!-- v4 FREE-BASE: low curb stairs + standing walk-across gap (no kinematic root) -->
    <geom name="start_pad" type="box" pos="0.00 0 0.015" size="0.40 0.45 0.015"
      material="start_mat" friction="1.6" condim="3"/>

    <!-- riser 0.03 m curb stairs. Tops at 0.03, 0.06, 0.09 -->
    <geom name="stair_1" type="box" pos="0.45 0 0.015" size="0.20 0.45 0.015"
      material="stair_mat" friction="2.0" condim="3"/>
    <geom name="stair_2" type="box" pos="0.85 0 0.03" size="0.20 0.45 0.03"
      material="stair2_mat" friction="2.0" condim="3"/>
    <geom name="stair_3" type="box" pos="1.25 0 0.045" size="0.20 0.45 0.045"
      material="stair3_mat" friction="2.0" condim="3"/>

    <!-- top landing top z=0.10. Spans x in [1.40, 2.10] -->
    <geom name="top_landing" type="box" pos="1.75 0 0.05" size="0.35 0.50 0.05" material="top_mat" friction="2.0" condim="3"/>

    <!-- gap 0.15 m then finish (same height) -->
    <geom name="finish_pad" type="box" pos="2.55 0 0.05" size="0.30 0.50 0.05" material="finish_mat" friction="2.0" condim="3"/>
    <geom name="finish_zone_marker" type="box" pos="2.55 0 0.55" size="0.22 0.22 0.015" material="zone_mat" contype="0" conaffinity="0"/>
  </worldbody>
</mujoco>
