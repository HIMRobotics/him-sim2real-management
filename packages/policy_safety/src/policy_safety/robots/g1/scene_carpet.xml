<mujoco model="g1_carpet">
  <!-- Bundled flat-floor scene with a commercial carpet floor. Robot geoms have
       priority 1, so the floor needs priority 2 for its friction to apply.
       Sliding 1.2 is a rough rubber-sole-on-loop-pile figure (the bundled floor
       is effectively 1.0); torsional and rolling stay at the robot's values. -->
  <include file="g1_robot.xml"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <geom name="safety_floor" type="plane" size="0 0 0.05" priority="2" condim="6"
          friction="1.2 0.005 0.0001" rgba="0.45 0.25 0.2 1"/>
  </worldbody>
</mujoco>
